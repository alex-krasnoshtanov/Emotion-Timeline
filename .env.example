# Copy to .env and fill in what you need. .env is gitignored; this file is not,
# so it holds names and never values.
#
#     cp .env.example .env
#
# Nothing committed to this repository requires any of these. The source corpus
# is public and ungated, and every published number derives from files under
# benchmarks/, so `pytest`, `dataset`, `models`, `model`, `errors`, `wer` and
# `figures` all run with none of them set. They are here for the stages that
# call a hosted service.
#
# An exported variable always wins over this file.

# Hugging Face. Only for private or gated repositories -- `build-dataset` does
# not need it. https://huggingface.co/settings/tokens
# Prefer a fine-grained token scoped to the repositories you actually read.
HF_TOKEN=

# AssemblyAI, for transcribing new audio. The committed benchmark needs nothing.
# https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=
